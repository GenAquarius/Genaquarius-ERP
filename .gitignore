# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.npm/
.yarn/

# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
dist/
build/
out/
client-dist/
code_stage5/
*.tsbuildinfo
.vite/
coverage/

# ---------------------------------------------------------------
# Environment files & secrets (keep only *.example templates)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Terraform state / secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform.lock.hcl

# ---------------------------------------------------------------
# Logs, archives, deploy bundles
# ---------------------------------------------------------------
*.log
logs/
applogs/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ---------------------------------------------------------------
# Scratch / temp / backup working folders
# ---------------------------------------------------------------
_scratch/
scratch/
tmp/
temp/
_backup*/
*.bak
*.tmp

# Prisma engine binaries (regenerated by `prisma generate`)
*.so.node
*.dll.node
*.dylib.node

# ---------------------------------------------------------------
# Local tool / assistant state
# ---------------------------------------------------------------
.claude/
memory/

# ---------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini
~$*

# Database / data dumps
*backup*.json
*.sql
*.dump
