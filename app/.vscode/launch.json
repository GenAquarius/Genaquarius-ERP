{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "--transpile-only", "src/index.ts"],
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug reconcile (parity check)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "--transpile-only", "src/engine/reconcile.ts"],
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal"
    }
  ]
}
