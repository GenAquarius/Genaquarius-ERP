# ---- Core ----
DATABASE_URL="mysql://costing:costing_pw@localhost:3307/costing"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# ---- Security ----
# In production set NODE_ENV=production. The server then REFUSES to start unless
# JWT_SECRET is strong (>=32 chars) and local login is explicitly enabled.
NODE_ENV="development"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES="12h"
SESSION_COOKIE="ga_session"

# Local email/password login. Dev: defaults ON. Production: OFF unless ="true".
ALLOW_LOCAL_LOGIN="true"

# Roles currently BLOCKED from signing in (any path). Default blocks rank-and-file
# so only provisioned admins can log in. Set to "" to allow everyone their access.
BLOCKED_SIGNIN_ROLES="EMPLOYEE,PROJECT_MANAGER"

# ---- Microsoft Entra (Azure AD) SSO — enables "Sign in with Microsoft" + 2FA ----
# Create an App Registration; add redirect URI = AZURE_REDIRECT_URI below.
# MFA/2FA is enforced by your tenant's Conditional Access (works in local dev too,
# just register http://localhost:4000/api/auth/azure/callback as a redirect URI).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="http://localhost:4000/api/auth/azure/callback"
# Auto-create a user on first SSO login if not provisioned. Default OFF so random
# genaquarius.com tenant users CANNOT sign in — only people you provision can.
AZURE_AUTO_PROVISION="false"
