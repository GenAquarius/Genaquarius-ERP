{
  "name": "genaquarius-erp-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node --transpile-only src/seed/importGolden.ts",
    "seed:hr": "ts-node --transpile-only src/seed/seedHr.ts",
    "seed:permissions": "ts-node --transpile-only src/seed/seedPermissions.ts",
    "seed:leave": "ts-node --transpile-only src/seed/seedLeave.ts",
    "seed:workflow": "ts-node --transpile-only src/seed/seedWorkflow.ts",
    "migrate:holidays-to-bu": "ts-node --transpile-only src/seed/migrateHolidaysToBu.ts",
    "reconcile": "ts-node --transpile-only src/engine/reconcile.ts",
    "dev:qa": "set \"ENV_FILE=.env.qa\" && ts-node-dev --respawn --transpile-only src/index.ts",
    "seed:qa": "set \"ENV_FILE=.env.qa\" && ts-node --transpile-only src/seed/importDummy.ts",
    "push:qa": "set \"DATABASE_URL=mysql://qa:qa_pw@localhost:3307/costing_qa\" && prisma db push --skip-generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.1",
    "socket.io": "^4.8.3",
    "xlsx-populate": "^1.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
